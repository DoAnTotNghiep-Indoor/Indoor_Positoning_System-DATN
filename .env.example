# Sao chép file này thành .env rồi điền thông tin thật.
# TUYỆT ĐỐI không commit file .env lên git.

# CSDL — SQLite, không cần cài server. Để trống thì dùng data/ips.db.
# Schema tránh cú pháp riêng của engine nên đổi sang engine khác chỉ đổi dòng này.
DATABASE_URL=sqlite+aiosqlite:///data/ips.db

# Đường dẫn artifact (hợp đồng dữ liệu + mô hình đã huấn luyện)
MODEL_DIR=artifacts

# Hậu xử lý vị trí
CUA_SO_GOP=3
RESET_AFTER_SECONDS=30

# CORS cho Dashboard
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5500"]
