# Sao chép file này thành .env rồi điền thông tin thật.
# TUYỆT ĐỐI không commit file .env lên git.

# Database
DATABASE_URL=postgresql+asyncpg://ips_user:CHANGE_ME@localhost:5432/ips_dlu

# Bảo mật
API_KEY=CHANGE_ME_random_string
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5500"]

# Đường dẫn artifact
MODEL_DIR=artifacts

# Tham số hậu xử lý vị trí
SMOOTHING_ALPHA=0.3
MAX_JUMP_DISTANCE_M=5.0
RESET_AFTER_SECONDS=30
